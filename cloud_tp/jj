# ---------- PostgreSQL ----------
@app.route("/sql/add", methods=["POST"])
def add_sql():
    data = request.json

    conn = get_connection()
    cur = conn.cursor()

    cur.execute(
        "INSERT INTO users_sql (name, age) VALUES (%s, %s);",
        (data.get("name"), data.get("age"))
    )

    conn.commit()
    cur.close()
    conn.close()

    return jsonify({"message": "Added to SQL"})


@app.route("/sql/users", methods=["GET"])
def get_sql():
    conn = get_connection()
    cur = conn.cursor()

    cur.execute("SELECT * FROM users_sql;")
    rows = cur.fetchall()

    cur.close()
    conn.close()

    result = []
    for r in rows:
        result.append({
            "id": r[0],
            "name": r[1],
            "age": r[2]
        })

    return jsonify(result)


